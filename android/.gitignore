gradle-wrapper.jar
/.gradle
/captures/
/gradlew
/gradlew.bat
/local.properties
GeneratedPluginRegistrant.java
.cxx/

# Remember to never publicly share your RELEASE keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks

# The debug keystore is the one exception: it's not sensitive (never used
# to sign anything distributed), and committing a fixed one gives every
# CI build the same signature — otherwise each ephemeral runner generates
# its own, and a locally-installed debug APK can never be updated by a
# newer CI build (INSTALL_FAILED_UPDATE_INCOMPATIBLE) without an
# uninstall first. See build.gradle.kts's `signingConfigs`.
!app/debug.keystore
